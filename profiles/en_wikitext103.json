{
  "schema_version": 1,
  "name": "en_wikitext103_sentencepiece",
  "dataset": {
    "source": "huggingface",
    "loader": "wikitext",
    "dataset_config": "wikitext-103-raw-v1",
    "text_column": "text",
    "language": "en",
    "revision": "main",
    "streaming": false,
    "splits": {
      "train": "train",
      "validation": "validation",
      "test": "test",
      "seed": 42
    }
  },
  "tokenizer": {
    "backend": "sentencepiece",
    "vocab_size": 16000,
    "model_type": "unigram",
    "normalization": "nmt_nfkc",
    "character_coverage": 1.0,
    "byte_fallback": true,
    "hard_vocab_limit": false,
    "training_sentence_limit": 1000000,
    "seed": 42
  }
}
