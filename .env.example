# Copy this file to .env and add only the keys for providers you use.
OPENAI_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=
# KaggleHub token generated from https://www.kaggle.com/settings/api
KAGGLE_API_TOKEN=
# S3-compatible object storage. AWS_SESSION_TOKEN is optional.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=
# Optional for MinIO, R2, or another S3-compatible endpoint.
S3_ENDPOINT_URL=
ATTENTION_MAPS_FINETUNED_MODELS_ROOT=
# Optional shared cleaning-workspace destination and local ADC credential path.
ATTENTION_MAPS_DRIVE_PARENT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
ATTENTION_MAPS_DRIVE_OAUTH_CLIENT=
ATTENTION_MAPS_DRIVE_OAUTH_TOKEN=.google-drive-token.json
