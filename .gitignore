# Python virtual environments
.venv/
.venv-*/
venv/
env/
ENV/

# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build and packaging outputs
build/
dist/
*.egg-info/

# Local secrets and machine-specific configuration
.env
.env.*
!.env.example
.dataset_generator_rate_limits.sqlite3
.dataset_generator.sqlite3

# Editors and operating-system metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Notebook scratch state (the notebooks themselves remain tracked)
.ipynb_checkpoints/

# Local corpora, preprocessing products, tokenizers, and model caches
/data/*
!/data/README.md
!/data/.gitkeep

# Generated training, inference, and visualization outputs
/runs/
/artifacts/
/checkpoints/
/finetuned_models/**/checkpoint-*/
/nepali_inference_results.csv
*.ckpt
*.pt
*.pth
*.safetensors

# Logs, crash dumps, and temporary files
*.log
core
core.*
*.tmp
*.temp

# Google Drive auth
credentials.json
client_secret*.json
token.json
